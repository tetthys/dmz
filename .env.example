# ============================================================
# .env.example for DMZ Secure Architecture Automation
# ------------------------------------------------------------
# Copy this file to ".env" and edit values to match your system.
# Both host_setup.sh and provision_dmv_stack.sh will automatically
# read variables from .env if present.
#
# NOTE:
#  - Keep this file private (do NOT commit .env to Git).
#  - Strings containing spaces should be wrapped in quotes.
#  - IPs and bridge names must match your nftables/firewall setup.
# ============================================================


# ===== Network Bridges =====
# Bridge interfaces created by host_setup.sh.
BR_EXTERNAL=br-external
BR_INTERNAL=br-internal


# ===== Host Bridge IPs (gateway addresses for VMs) =====
# These IPs belong to the host system (the KVM/libvirt server),
# and will serve as gateways for each network segment.
HOST_DMZ_GW=192.0.2.1
HOST_INT_GW=10.10.0.1


# ===== VM Static IPs and Names =====
# The VMs themselves will use these static IPs (set via cloud-init).
# They must align with nftables firewall rules.
WEB_VM_NAME=web-vm
WEB_VM_IP=192.0.2.101
WEB_VM_CIDR=24

INTERNAL_VM_NAME=internal-vm
INTERNAL_VM_IP=10.10.0.11
INTERNAL_VM_CIDR=24


# ===== Network Interface Name inside Guest =====
# Default network device name inside the Ubuntu cloud image.
# Usually "ens3" or "enp1s0". Adjust after checking `ip a` inside VM.
GUEST_IFACE_NAME=ens3


# ===== VM Resources =====
# CPU and RAM for each VM (in MB).
WEB_VM_MEM=4096
WEB_VM_CPUS=2
INTERNAL_VM_MEM=4096
INTERNAL_VM_CPUS=2


# ===== Storage and Cloud Image Paths =====
# Directory for all disk images.
IMG_DIR=/var/lib/libvirt/images

# Location of the Ubuntu cloud base image.
# You can use a local mirror if available for faster setup.
CLOUD_IMG=${IMG_DIR}/ubuntu-22.04-server-cloudimg-amd64.img
CLOUD_IMG_URL=https://cloud-images.ubuntu.com/jammy/current/jammy-server-cloudimg-amd64.img

# Directory where cloud-init "seed" ISOs will be stored.
SEED_DIR=/var/lib/libvirt/cloud-seed


# ===== Internal API Port (DMZ -> Internal Communication) =====
# Only this port will be allowed from the DMZ (web-vm) to the internal network.
INTERNAL_API_PORT=8443


# ===== SSH Key to Inject into Both VMs =====
# IMPORTANT:
#   - Paste your public SSH key here (id_ed25519.pub or id_rsa.pub).
#   - Wrap it in double quotes if it contains spaces.
SSH_PUBLIC_KEY="ssh-ed25519 AAAAC3Nz... yourname@host"


# ===== System Timezone =====
# Used for both VMs via cloud-init.
TIMEZONE=Asia/Seoul


# ===== Logging & Behavior =====
# VERBOSE=1 enables command tracing and detailed logs.
# WAIT_SSH=1 waits for SSH ports to open after VM boot (slower but safer).
# Set WAIT_SSH=0 to skip waiting and finish faster.
VERBOSE=1
WAIT_SSH=0
SSH_TIMEOUT_SEC=180


# ===== Host NAT / Firewall Variables =====
# Physical interface used for outbound NAT (masquerade).
EXT_IF=eth0

# Whitelisted external destination (for example: a Bank API endpoint).
BANK_API_IP=203.0.113.55

# These are aliases used inside nftables configuration.
WEB_VM_ADDR=${WEB_VM_IP}
INTERNAL_VM_ADDR=${INTERNAL_VM_IP}


# ===== Temporary password login for console/SSH (LAB ONLY) =====
# Enable password auth inside the VMs (default: 0 = disabled)
ENABLE_PW_AUTH=1

# Username / password to provision (only used when ENABLE_PW_AUTH=1)
LOGIN_USERNAME=ubuntu
LOGIN_PASSWORD=ubuntu

# Optionally lock password & disable SSH password auth AFTER first boot
# 1 = on-boot hardening (locks the account password and disables SSH password login)
DISABLE_PW_ON_BOOT=1
